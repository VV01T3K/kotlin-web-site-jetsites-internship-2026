{
  "name": "my-react-router-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun react-router dev --host",
    "build": "bun --bun react-router build",
    "start": "node ./node_modules/@react-router/serve/bin.js ./build/server/index.js",
    "typecheck": "bun --bun react-router typegen && tsgo --noEmit"
  },
  "dependencies": {
    "@jetbrains/kotlin-web-site-ui": "4.14.5",
    "@react-router/node": "7.13.1",
    "@react-router/serve": "7.13.1",
    "@rescui/button": "0.23.3",
    "@rescui/card": "0.13.10",
    "@rescui/tab-list": "0.16.3",
    "@rescui/typography": "0.24.3",
    "@rescui/ui-contexts": "0.6.0",
    "classnames": "^2.5.1",
    "highlight.js": "^11.11.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.13.1",
    "isbot": "^5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-router/dev": "7.13.1",
    "@rolldown/plugin-babel": "^0.2.1",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260316.1",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "sass": "^1.98.0",
    "vite": "^8.0.0"
  }
